        "standardwebhooks": "^1.0.0",
        "typeorm": "^1.0.0",
        "yamljs": "^0.3.0"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.2.0",
        "@eslint/js": "^9.18.0",
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
