# Configuración de pnpm para permitir builds de dependencias seguras
# Esto permite que bcrypt compile módulos nativos (necesario para hashear contraseñas)
# y que @nestjs/core funcione correctamente
allowBuilds[]=@nestjs/core
allowBuilds[]=bcrypt
allowBuilds[]=unrs-resolver
# Solución para dependencias internas de Resend
public-hoist-pattern[]=*