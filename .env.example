# Entorno (OBLIGATORIA: development | production; la app no arranca sin ella)
NODE_ENV=development

# Nombre del proyecto (prefijo para nombres de contenedores y redes).
# Compose lo usa como prefijo y le añade el sufijo del servicio, p. ej.
# ${PROJECT_NAME}-backend y ${PROJECT_NAME}-db. Por eso se deja sin "-backend".
PROJECT_NAME=petrogassa-landing

# Puerto de la aplicación
PORT=3000

# JWT (mínimo 32 caracteres). Generar uno único por entorno con:
#   openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
# Expiración del token de reset de contraseña (horas)
VERIFICATION_TOKEN_EXPIRES_IN_HOURS=1
# Expiración del token de activación/invitación de cuenta (horas)
ACCOUNT_ACTIVATION_TOKEN_EXPIRES_IN_HOURS=48

# Base de datos
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=tu_usuario
DATABASE_PASSWORD=tu_contraseña
DATABASE_NAME=nombre_bd

# Puertos para Docker
HOST_PORT=3000
DATABASE_HOST_PORT=5432

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# URL pública del frontend, SIN barra final (se usa para CORS y para los
# enlaces de los correos de activación y reset)
FRONTEND_URL=

# Email del admin inicial. Al primer arranque (si no hay ningún admin) se crea
ADMIN_EMAIL=
