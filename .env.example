# Entorno (OBLIGATORIA: development | production; la app no arranca sin ella)
NODE_ENV=development

# Nombre del proyecto (prefijo para nombres de contenedores y redes).
# Compose lo usa como prefijo y le añade el sufijo del servicio, p. ej.
# ${PROJECT_NAME}-backend y ${PROJECT_NAME}-db. Por eso se deja sin "-backend".
PROJECT_NAME=petrogassa-landing

# Puerto de la aplicación
PORT=3100

# JWT (mínimo 32 caracteres). Generar uno único por entorno con:
#   openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
# Expiración del token de reset de contraseña (horas)
VERIFICATION_TOKEN_EXPIRES_IN_HOURS=1
# Expiración del token de activación/invitación de cuenta (horas)
ACCOUNT_ACTIVATION_TOKEN_EXPIRES_IN_HOURS=48

# Base de datos
DATABASE_HOST=localhost
DATABASE_PORT=5434
DATABASE_USER=tu_usuario
DATABASE_PASSWORD=tu_contraseña
DATABASE_NAME=nombre_bd

# Puertos para Docker
HOST_PORT=3100
DATABASE_HOST_PORT=5434

# ── CORREO ────────────────────────────────────────────────────────────────
# Proveedor activo: "envialosimple" (por defecto) o "resend". Se exige SOLO la
# API key del proveedor elegido; la del otro puede quedar vacía. Cambiar de
# proveedor es cambiar esta línea y reiniciar: no se toca código.
MAIL_PROVIDER=envialosimple

# Remitente (común a ambos proveedores). El dominio debe estar VERIFICADO en el
# proveedor activo, con SPF/DKIM configurados, o los envíos se rechazan.
MAIL_FROM_EMAIL=no-reply@petrogassa.com
MAIL_FROM_NAME=Petrogassa


# ── Opción A: EnvíaloSimple Transaccional (DonWeb) ────────────────────────
# La API key se genera POR DOMINIO desde el panel:
#   Mis Dominios → Administración del dominio → API Key
ENVIALOSIMPLE_API_KEY=
# Base de la API (normalmente no se cambia; útil para apuntar a un mock)
ENVIALOSIMPLE_API_BASE_URL=https://api.envialosimple.email/api/v1

# ── Opción B: Resend ──────────────────────────────────────────────────────
# Solo hace falta si MAIL_PROVIDER=resend. Es el único de los dos que soporta
# claves de idempotencia (no duplica el correo si un envío se reintenta).
RESEND_API_KEY=

# URL pública del frontend, SIN barra final (se usa para CORS y para los
# enlaces de los correos de activación y reset)
FRONTEND_URL=

# Dominio público del sitio (base de las URLs del sitemap). SIN barra final.
# En staging apuntá a ese dominio para no publicar URLs del sitio productivo.
PUBLIC_SITE_URL=https://petrogassa.com

# Email del admin inicial. Al primer arranque (si no hay ningún admin) se crea
ADMIN_EMAIL=nicolas.espinoza@petrogassa.com

# ── ALMACENAMIENTO DE ARCHIVOS (filesystem) ───────────────────────────────
# Las imágenes del sitio se guardan en disco, no en un servicio externo. Esta
# ruta es la de DENTRO del contenedor; en desarrollo es una carpeta local que
# se crea sola. El usuario que corre el backend debe poder escribir ahí.
#
# Debajo de STORAGE_PATH se arma UNA sola área:
#   public/   -> imágenes y PDFs del sitio, servidos por HTTP.
# No hay área privada: todo lo que se guarda acá es público. Los CV de las
# postulaciones no tocan disco, se reenvían a Gestión Petrogas.
STORAGE_PATH=./storage

# Base de las URLs públicas de las imágenes. Es OBLIGATORIA y no tiene valor por
# defecto: en producción tiene que apuntar al dominio real.
#
# SOLO EL ORIGEN: sin ruta y sin barra final. `https://petrogassa.com`, nunca
# `https://petrogassa.com/api`. Los archivos se sirven en la RAÍZ del backend,
# así que la URL de una imagen es `<origen>/media/...`; con una ruta acá, las
# URLs que devuelve la API apuntan a donde no hay nada. El arranque lo rechaza
# con un mensaje claro, porque el síntoma es mudo: la subida responde 200 y el
# 404 aparece recién cuando alguien mira el sitio.
#
# La otra mitad de esto vive en el proxy: el nginx del host tiene que mandar
# /media al backend (ver el README, sección de producción).
MEDIA_PUBLIC_BASE_URL=http://localhost:3100

# Solo para docker-compose de PRODUCCIÓN: ruta del HOST que se monta dentro del
# contenedor en STORAGE_PATH.
#
# Va SIN definir a propósito. El compose ya cae en ../data/storage, que queda
# junto al proyecto y fuera de todo docroot. Definirla solo tiene sentido para
# mandar las imágenes a otro disco o a un montaje de red; en ese caso la ruta
# debe ser ABSOLUTA y escribible por el UID 1000 con el que corre el
# contenedor.
# HOST_STORAGE_PATH=/ruta/absoluta/en/el/host

# Buzón que recibe los mensajes del formulario de contacto
CONTACT_INBOX_EMAIL=


# ── LinkedIn (importación de novedades) ───────────────────────────────────
# Trae posteos de la página de LinkedIn a una cola de curaduría; admin/rrhh
# aprueba cuáles se publican en la web. TODO opcional: sin esto la app arranca
# igual.
#   stub = posteos de ejemplo, para desarrollo/pruebas (no llama a LinkedIn).
#   api  = Community Management API real. Requiere que LinkedIn APRUEBE el
#          acceso al producto, ser admin de la página, y completar el token +
#          el URN de la organización de abajo.
LINKEDIN_FETCH_MODE=stub
# URN de la organización (página de empresa), p. ej. urn:li:organization:12345
LINKEDIN_ORGANIZATION_URN=
# Access token OAuth con scope r_organization_social (dura ~60 días; hay que
# renovarlo). Es un SECRETO: no commitear.
LINKEDIN_ACCESS_TOKEN=
# Versión de la API (header LinkedIn-Version, formato AAAAMM)
LINKEDIN_API_VERSION=202401
# Base de la API (normalmente no se cambia)
LINKEDIN_API_BASE_URL=https://api.linkedin.com

# ── Integración con Gestión Petrogas ─────────────────────────────────────────
# Las postulaciones se reenvían a la API de Gestión (servidor a servidor).
# El token lo provee gestion.petrogassa.com y es SECRETO: va solo acá, nunca
# en el frontend. NO commitear el valor real.
GESTION_API_BASE_URL=https://gestion.petrogassa.com/api/v1
GESTION_API_TOKEN=
