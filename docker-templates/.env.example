# Plantilla de variables de entorno para NestJS + Docker
# Copia este archivo y renómbralo a .env.dev o .env.prod según el entorno
# NO SUBAS LOS ARCHIVOS .env.dev o .env.prod A GIT!

# Entorno
NODE_ENV=development

# Nombre del proyecto (para nombres de contenedores y redes)
PROJECT_NAME=tu-nombre-proyecto

# Puerto de la aplicación
PORT=3000

# JWT (mínimo 32 caracteres). Generar uno único por entorno con:
#   openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Base de datos PostgreSQL
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_USER=tu_usuario
DATABASE_PASSWORD=tu_contraseña
DATABASE_NAME=nombre_bd

# Puertos para Docker (HOST: puerto de tu PC/VPS, CONTAINER: puerto dentro del contenedor)
HOST_PORT=3000
DATABASE_HOST_PORT=5432
