{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    // "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    // "baseUrl": "./",
    "incremental": true,
    // El cache incremental vive DENTRO de dist/. nest-cli tiene
    // deleteOutDir:true, que borra dist/ antes de cada build; si el cache
    // quedara en la raíz sobreviviría a ese borrado y tsc creería que ya
    // compiló ("Found 0 errors" pero sin emitir), dejando dist/ vacío y
    // rompiendo el arranque con "Cannot find module dist/main". Poniéndolo
    // acá, cache y salida se borran juntos y nunca se desincronizan.
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo",
    // "skipLibCheck": true,
    // "strictNullChecks": true,
    // "forceConsistentCasingInFileNames": true,
    // "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "strict": true,
    "strictPropertyInitialization": false,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    // Con moduleResolution nodenext, TS ya no incluye automáticamente TODOS
    // los @types/* del proyecto (@types/jest quedaba afuera sin esto,
    // rompiendo describe/it/expect en los *.spec.ts). Se listan explícitos.
    "types": ["node", "jest"]
  },
  // test/ tiene su propio tsconfig vía test/jest-e2e.json (rootDir ".",
  // no bajo src/); acá se excluye para no chocar con el rootDir explícito.
  "exclude": ["node_modules", "dist", "test"]
}
